+
+// ParseConfigStrict builds a Config exclusively from connString. Unlike
+// ParseConfig, it never reads libpq environment variables, the OS user,
+// service files, passfiles, or implicit client certificates from the user's
+// home directory. It also forbids TLS downgrade and multi-host fallback.
+//
+// The connection string must explicitly provide host, port, database (or
+// dbname), user, password, and sslmode. TCP connections must use verify-full,
+// except that disable is accepted for numeric loopback IP addresses. Unix
+// domain sockets must use disable. Only the fixed connection, CA, and
+// application-name parameters used by AOCI are accepted.
+func ParseConfigStrict(connString string) (*Config, error) {
+	if separator := strings.Index(connString, "://"); separator >= 0 {
+		scheme := strings.ToLower(strings.TrimSpace(connString[:separator]))
+		if scheme != "postgres" && scheme != "postgresql" && scheme != "opengauss" {
+			return nil, &parseConfigError{
+				connString: connString,
+				msg:        fmt.Sprintf("connection protocol %s is not permitted by strict configuration", scheme),
+			}
+		}
+	}
+	connStringSettings, err := ParseURLToMap(connString)
+	if err != nil {
+		return nil, err
+	}
+
+	allowedParameters := map[string]struct{}{
+		paramHost: {}, paramPort: {}, paramDatabase: {}, paramUser: {},
+		paramPassword: {}, paramSSLMode: {}, paramSSLRootCert: {},
+		paramApplicationName: {},
+	}
+	for parameter := range connStringSettings {
+		if _, permitted := allowedParameters[parameter]; !permitted {
+			return nil, &parseConfigError{
+				connString: connString,
+				msg:        fmt.Sprintf("%s is not permitted by strict configuration", parameter),
+			}
+		}
+	}
+	if rootCertificate, present := connStringSettings[paramSSLRootCert]; present {
+		if strings.TrimSpace(rootCertificate) == "" || !filepath.IsAbs(rootCertificate) {
+			return nil, &parseConfigError{
+				connString: connString,
+				msg:        "sslrootcert must be an absolute path in strict configuration",
+			}
+		}
+	}
+
+	for _, parameter := range []string{
+		paramHost,
+		paramPort,
+		paramDatabase,
+		paramUser,
+		paramPassword,
+		paramSSLMode,
+	} {
+		if strings.TrimSpace(connStringSettings[parameter]) == "" {
+			return nil, &parseConfigError{
+				connString: connString,
+				msg:        fmt.Sprintf("%s must be explicitly provided by strict configuration", parameter),
+			}
+		}
+	}
+
+	host := connStringSettings[paramHost]
+	if strings.Contains(host, ",") || strings.Contains(connStringSettings[paramPort], ",") {
+		return nil, &parseConfigError{
+			connString: connString,
+			msg:        "multiple hosts are not permitted by strict configuration",
+		}
+	}
+
+	sslmode := connStringSettings[paramSSLMode]
+	network, _ := NetworkAddress(host, 1)
+	if network == "unix" {
+		if sslmode != "disable" {
+			return nil, &parseConfigError{
+				connString: connString,
+				msg:        "Unix domain sockets must use sslmode=disable in strict configuration",
+			}
+		}
+	} else {
+		switch sslmode {
+		case "verify-full":
+		case "disable":
+			if !isStrictNumericLoopbackHost(host) {
+				return nil, &parseConfigError{
+					connString: connString,
+					msg:        "sslmode=disable is permitted only for a numeric loopback IP address",
