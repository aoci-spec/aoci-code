      "id": "contracts/runtime-rules",
      "kind": "contract",
      "path": "contracts/runtime-rules.txt",
      "description": "Short-form MCP host-agent behavior contract returned by aoci_rules",
      "used_by": "internal/index/query.go:BuildRuntimeRules",
      "protocol_tokens": [
        "aoci_rules",
        "aoci_overview",
        "aoci_header",
        "aoci_maintain",
        "aoci_update_entry",
        "aoci_report",
        "runtime_repository_root",
        "index_sha256",
        "mcp_service_version",
        "cognition_scope",
        "cognition_refresh_threshold",
        "context_compaction",
        "semantic_threshold",
        "phase_transition",
        "refresh_event_id",
        "refresh_not_required",
        "refresh_required",
        "refresh_deferred_until_stable",
        "refresh_ready_for_overview",
        "valid",
        "uncertain",
        "invalid",
        "no_cognition",
        "index_loaded",
        "delivery_verified",
        "cognition-state/v2",
        "model_cognition_usable",
        "strict_attestation_verified",
        "governance_aligned",
        "current_system_cognition_reliable",
        "cognition_verified",
        "cognition_governed",
        "aligned=true",
        "status=applied",
        "repair_required",
        "stopped",
        "source_sha256",
        "entries",
        "findings",
        "failed_step",
        "error",
        "recovery",
        "format-only",
        "aoci.txt",
        ".aoci"
      ],
      "locale_anchors": {
        "zh-CN": [
          "不能替代匹配当前AOCI身份的认知收据",
          "该结果保留已交付认知的实际scope和状态",
          "只有current_system_cognition_reliable=true允许无保留地声称当前完整系统认知可靠",
          "aoci_maintain只用于已建立索引的增量维护",
          "只在当前布局和工具返回状态支持时使用 aoci_report",
          "Prompt只约束模型语义生成",
          "机器数值、词表与集合只由当前编译版本的internal/machinecontract提供"
        ]
      }
    },
