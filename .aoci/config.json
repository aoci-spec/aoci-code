{
  "version": 2,
  "locale": "en-US",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "target",
    ".next",
    "coverage",
    "tmp",
    "uploads",
    "backup",
    "backups",
    "artifacts",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 14000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "auto",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "public-en-us-runtime-assets-observe",
        "action": "observe",
        "pattern": "textassets/en-US/**",
        "pattern_kind": "glob",
        "reason": "Public locale bodies are governed by manifests and loaders; observe exact bytes without duplicating each body in Whole-Index",
        "source": "user",
        "created_by": "codex-public-bootstrap",
        "order": 100,
        "enabled": true
      },
      {
        "rule_id": "public-zh-cn-runtime-assets-observe",
        "action": "observe",
        "pattern": "textassets/zh-CN/**",
        "pattern_kind": "glob",
        "reason": "Public locale bodies are governed by manifests and loaders; observe exact bytes without duplicating each body in Whole-Index",
        "source": "user",
        "created_by": "codex-public-bootstrap",
        "order": 101,
        "enabled": true
      },
      {
        "rule_id": "public-aoci-logo-en-observe",
        "action": "observe",
        "pattern": "assets/aoci-logo-en.jpg",
        "pattern_kind": "file",
        "reason": "Track the published English logo bytes without creating a binary-image Whole-Index Entry; README and release archive configuration own its semantics",
        "decision_basis": "semantic_density",
        "source": "user",
        "created_by": "codex-pr-2-integration",
        "order": 102,
        "enabled": true
      },
      {
        "rule_id": "public-aoci-logo-zh-cn-observe",
        "action": "observe",
        "pattern": "assets/aoci-logo-zh-CN.jpg",
        "pattern_kind": "file",
        "reason": "Track the published Chinese logo bytes without creating a binary-image Whole-Index Entry; README and release archive configuration own its semantics",
        "decision_basis": "semantic_density",
        "source": "user",
        "created_by": "codex-pr-2-integration",
        "order": 103,
        "enabled": true
      },
      {
        "rule_id": "public-blackbox-mcp-harness-observe",
        "action": "index",
        "pattern": "scripts/blackbox/mcp_*.py",
        "pattern_kind": "glob",
        "reason": "Each MCP harness is an executable contract run by name with its own preconditions, so it earns a Whole-Index Entry; an Entry costs about 110 tokens of FRAS and never the Python body, so the earlier exclusion rested on a wrong cost model",
        "decision_basis": "semantic_density",
        "source": "user",
        "created_by": "alkor2000",
        "order": 104,
        "enabled": true
      },
