# AOCI MCP server installed by aoci init for this project.
# Codex loads .codex/config.toml only for trusted projects. If prompted when
# opening this repository for the first time, review the project and grant trust.
[mcp_servers.aoci]
command = {{printf "%q" .BinPath}}
args = ["--repo", {{printf "%q" .RepoRoot}}, "mcp"]
